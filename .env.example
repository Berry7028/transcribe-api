# OpenAI（Speech to Text 利用時に必須）
OPENAI_API_KEY=

# 文字起こしモデル（未設定時はアプリ側デフォルト）
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# チャンク分割（未設定時はアプリ側デフォルト）
# OPENAI_MAX_UPLOAD_BYTES=26214400
# CHUNK_TARGET_BYTES=20971520
# CHUNK_MAX_BYTES=24117248
# CHUNK_MIN_SILENCE_LEN_MS=700
# CHUNK_SILENCE_THRESH_DB_OFFSET=16
# CHUNK_KEEP_SILENCE_MS=300

# ローカル起動用（任意）
# HOST=0.0.0.0
# PORT=8000
